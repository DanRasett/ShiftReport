{
  "expo": {
    "name": "ShiftReport",
    "slug": "ShiftReport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1d23"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.shiftreport",
      "infoPlist": {
        "NSCameraUsageDescription": "Нужен доступ к камере для фотографирования чеков",
        "NSPhotoLibraryUsageDescription": "Нужен доступ к галерее для выбора фото чеков",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1d23"
      },
      "package": "com.yourcompany.shiftreport"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "static": "web"
    },
    "plugins": [
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "d58daa6a-a4c8-49bf-b0ec-a3a147dd5ee5"
      }
    }
  }
}